/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Ancestry-Aware GWAS Pipeline Configuration
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    A comprehensive Nextflow pipeline for multi-ancestry GWAS analysis
    with fine-mapping, meta-analysis, PRS, and functional annotation
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

// Global default params
params {
    // =====================
    // INPUT/OUTPUT OPTIONS
    // =====================
    input                      = null          // Samplesheet with genotype data paths
    outdir                     = './results'
    publish_dir_mode           = 'copy'

    // =====================
    // GENOTYPE DATA OPTIONS
    // =====================
    genotype_format            = 'plink2'      // 'plink1', 'plink2', 'bgen', 'vcf'
    genome_build               = 'GRCh38'      // 'GRCh37' or 'GRCh38'
    maf_threshold              = 0.01
    hwe_threshold              = 1e-6
    geno_missing               = 0.02
    mind_missing               = 0.02

    // =====================
    // PHENOTYPE OPTIONS
    // =====================
    // The phenotype file should be a tab-separated file with:
    //   - Column 1: Sample ID (IID) matching genotype data
    //   - Column 2: Family ID (FID) if applicable, or same as IID
    //   - Remaining columns: Phenotypes and covariates
    phenotype_file             = null
    phenotype_cols             = null          // Comma-separated list of phenotype columns

    // =====================
    // TRAIT SPECIFICATION
    // =====================
    // Specify which traits to analyze and their types
    // Example: binary_traits = 'leukemia_status,relapse'
    // Example: quantitative_traits = 'wbc_count,mrd_level,survival_time'
    binary_traits              = null          // Comma-separated list of BINARY trait names (case-control)
    quantitative_traits        = null          // Comma-separated list of QUANTITATIVE trait names

    // =====================
    // MULTI-TRAIT FINE-MAPPING (MG-FLASH-FM)
    // =====================
    // For MG-FLASH-FM multi-trait fine-mapping, specify which traits are RELATED
    // and should be analyzed jointly. The pipeline will use MG-FLASH-FM for related
    // traits and SuSIE-ME for single/unrelated traits.
    //
    // Option 1: Set related_traits = true to analyze ALL traits jointly
    // Option 2: Specify trait groups explicitly with related_trait_groups
    //
    // Example: related_trait_groups = 'wbc_count,platelet_count,rbc_count|all_leukemia,aml,all'
    //          This creates two groups: blood counts | leukemia subtypes
    //          Traits in same group are analyzed jointly with MG-FLASH-FM
    related_traits             = true          // Analyze all traits jointly (true) or separately (false)
    related_trait_groups       = null          // Explicit trait grouping: 'trait1,trait2|trait3,trait4'

    // =====================
    // COVARIATE SPECIFICATION
    // =====================
    // Covariates for mixed model GWAS (REGENIE, SAIGE, BOLT-LMM, GENESIS)
    // Specify column names from phenotype file
    //
    // Example for leukemia cohort:
    //   covariate_cols = 'age,sex,PC1,PC2,PC3,PC4,PC5,tumor_subtype,mrd_status,treatment_arm'
    //
    // Standard covariates to include:
    //   - age (continuous)
    //   - sex (binary: 0/1 or M/F)
    //   - PC1-PC10 (ancestry principal components - CRITICAL for multi-ancestry)
    //   - genotyping_batch (if applicable)
    //
    // Disease-specific covariates (examples):
    //   - tumor_subtype (categorical: B-ALL, T-ALL, AML, etc.)
    //   - mrd_status (binary: positive/negative)
    //   - treatment_arm (categorical)
    //   - cytogenetic_risk (categorical: favorable, intermediate, adverse)
    //   - wbc_at_diagnosis (continuous)
    //
    // The pipeline automatically handles:
    //   - Categorical variables: converted to dummy variables
    //   - Missing data: samples with missing covariates excluded or imputed
    covariate_cols             = null          // Comma-separated list of covariate columns

    // Categorical covariates (pipeline auto-detects, but can specify explicitly)
    // Example: categorical_covariates = 'sex,tumor_subtype,treatment_arm'
    categorical_covariates     = null          // Comma-separated list of categorical covariate names

    // Quantitative covariates (pipeline auto-detects, but can specify explicitly)
    // Example: quantitative_covariates = 'age,PC1,PC2,PC3,PC4,PC5,wbc_at_diagnosis'
    quantitative_covariates    = null          // Comma-separated list of quantitative covariate names

    // =====================
    // ANCESTRY OPTIONS
    // =====================
    // NOTE: Ancestry inference is OPTIONAL - you can provide pre-computed ancestry calls
    // or use this pipeline's built-in ancestry inference
    run_ancestry_inference     = false         // Set to true to run ancestry inference in this pipeline
    ancestry_calls_file        = null          // Pre-computed ancestry calls (sample_id, ancestry columns)
    ancestry_method            = 'graf-anc'    // 'graf-anc' (jimmy-penn 40-group), 'graf-pop', 'admixture', 'pca'
    graf_reference             = null          // Path to GRAF reference files

    // =====================
    // GRAF-ANC ANCESTRY CATEGORIES
    // =====================
    // GRAF-ANC infers ancestry into ~40 subpopulations organized into 8 major groups.
    // Use the category names directly (not numeric codes).
    //
    // MAJOR GROUPS (8 continental categories):
    //   AFR  = African (includes West, East, South African populations)
    //   MEN  = Middle Eastern / North African
    //   EUR  = European (Northern, Southern, Eastern, Ashkenazi)
    //   SAS  = South Asian (Indian subcontinent)
    //   EAS  = East Asian (Chinese, Japanese, Korean, Southeast Asian)
    //   AMR  = American / Indigenous (Native American)
    //   OCN  = Oceanian (Melanesian, Polynesian, etc.)
    //   MIX  = Mixed / Admixed (heterogeneous ancestry)
    //
    // ADMIXED SUBGROUPS (for Tractor local ancestry analysis):
    //   AAC   = African American (AFR-EUR 2-way admixed)
    //   LAT1  = Mexican / Central American Latino (EUR-AFR-NAT 3-way admixed)
    //   LAT2  = Caribbean / South American Latino (EUR-AFR-NAT 3-way admixed)
    //   LATINO = LAT1 + LAT2 combined for analysis
    //
    // NOTE: AAC is AFR-EUR admixed and uses 2-way Tractor (EUR + AFR ancestral components)
    //       Latino groups use 3-way Tractor (EUR + AFR + Native American components)

    // Mapping for pipeline (use these category names in ancestry_groups)
    ancestry_groups            = 'AFR,MEN,EUR,SAS,EAS,AMR,OCN,AAC,LAT1,LAT2,LATINO'
    major_ancestry_groups      = 'AFR,MEN,EUR,SAS,EAS,AMR,OCN,MIX'  // 8 major continental groups
    admixed_groups             = 'AAC,LAT1,LAT2,LATINO'             // Groups for Tractor analysis
    min_ancestry_n             = 100           // Minimum samples per ancestry for GWAS
    include_heterogeneous      = true          // Include heterogeneous ancestry group
    local_ancestry             = false         // Perform local ancestry inference
    local_ancestry_method      = 'rfmix'       // 'rfmix', 'gnomix', 'flare'
    local_ancestry_reference   = null          // Reference panels for local ancestry

    // =====================
    // GWAS OPTIONS
    // =====================
    // Standard tools: regenie, saige, bolt-lmm, plink2
    // Admixed-optimized: genesis (handles complex relatedness), saige (case-control imbalance)
    gwas_tool                  = 'regenie'     // 'regenie', 'saige', 'bolt-lmm', 'plink2', 'genesis'
    gwas_model                 = 'additive'    // 'additive', 'dominant', 'recessive'
    include_sex_chromosomes    = true
    chunk_size                 = 500           // Variants per chunk for parallelization
    p_threshold                = 5e-8          // Genome-wide significance threshold
    suggestive_threshold       = 1e-5          // Suggestive significance threshold

    // GENESIS-specific options (recommended for admixed populations)
    kinship_matrix             = null          // Pre-computed kinship/GRM matrix for GENESIS
    genesis_test               = 'Score'       // 'Score', 'Wald', 'BinomiRare', 'CMP'

    // =====================
    // TRACTOR OPTIONS (Local Ancestry-Aware GWAS)
    // =====================
    // Recommended for admixed populations: AAC (code 107), Latino (LAT1+LAT2)
    // Decomposes genetic effects by ancestral origin
    //
    // TRACTOR MODELS:
    //   - AAC 2-way (default): AFR + EUR components
    //   - AAC 3-way (optional): AFR + EUR + AMR (if significant Native American ancestry)
    //   - Latino 3-way: EUR + AFR + AMR (always 3-way for LAT1/LAT2)
    //   - Mixed 3-way: AFR + EUR + AMR (for code 800 with all 3 components)
    //
    // NOTE: LAT1 and LAT2 are COMBINED for Tractor analysis (better statistical power)
    run_tractor                = false            // Run Tractor for admixed groups
    tractor_groups             = 'AAC,LATINO'     // Groups for Tractor (LATINO = LAT1+LAT2 combined)

    // African American Tractor configuration
    // Default is 2-way (AFR,EUR). Set to 'AFR,EUR,AMR' for 3-way if AMR component detected
    tractor_aac_pops           = 'AFR,EUR'        // Ancestral pops for AAC: 'AFR,EUR' (2-way) or 'AFR,EUR,AMR' (3-way)
    tractor_aac_model          = '2-way'          // '2-way' or '3-way' - overrides tractor_aac_pops if set

    // Latino Tractor configuration (always 3-way)
    tractor_lat_pops           = 'EUR,AFR,AMR'    // Ancestral pops for Latino (3-way: EUR + AFR + Native American)

    // Mixed/Other 3-way configuration
    tractor_mix_pops           = 'AFR,EUR,AMR'    // Ancestral pops for mixed 3-way individuals

    // Local ancestry files
    local_ancestry_files       = null             // Path to local ancestry MSP files (RFMix format)

    // =====================
    // TRACTOR → GENESIS ADAPTER OPTIONS
    // =====================
    // Integrates Tractor local ancestry decomposition with GENESIS mixed models
    // Enables ancestry-specific effects with proper handling of:
    //   - Relatedness via kinship matrix
    //   - Population structure via PC covariates
    //   - Time-to-event outcomes (Cox proportional hazards)
    //
    // WORKFLOW:
    //   1. Run Tractor to extract ancestry-specific dosages (TRACTOR_EXTRACT_TRACTS)
    //   2. Prepare GDS with Tractor dosages (TRACTOR_GENESIS_PREPARE)
    //   3. Run GENESIS association with ancestry decomposition
    //
    // WHEN TO USE:
    //   - Standard Tractor: Binary traits ONLY (logistic regression)
    //   - Tractor-GENESIS Adapter: Binary, quantitative, OR survival traits
    //   - Required for: OS, relapse, MRD analyses in admixed populations
    //
    // OUTPUT:
    //   - Joint test: Tests if ANY ancestry has effect (Wald test)
    //   - Marginal tests: Ancestry-specific betas, SEs, p-values
    //   - Heterogeneity test: Q statistic, I² for effect differences
    //
    run_tractor_genesis        = false            // Use Tractor→GENESIS adapter
    tractor_genesis_model      = 'auto'           // 'survival', 'binary', 'quantitative', 'auto'
                                                  // 'auto' detects from trait type

    // =====================
    // SURVIVAL/TIME-TO-EVENT ANALYSIS (SPA-Cox)
    // =====================
    survival_analysis          = false         // Run time-to-event GWAS
    time_col                   = null          // Column name for time-to-event
    event_col                  = null          // Column name for event indicator (1=event, 0=censored)
    survival_traits            = null          // Comma-separated list of survival phenotypes

    // =====================
    // META-ANALYSIS OPTIONS
    // =====================
    meta_analysis              = true
    meta_method                = 'mr-mega'     // 'mr-mega', 'metal', 'metasoft'
    heterogeneity_test         = true          // Cochran's Q and I²

    // =====================
    // MR-MEGA WITH ENVIRONMENTAL VARIABLES (env-MR-MEGA)
    // =====================
    // Reference: Wang et al. Communications Biology 2024 (PMID: 39543362)
    // https://www.nature.com/articles/s42003-024-07236-9
    //
    // Env-MR-MEGA adjusts for environmental heterogeneity between studies
    // by incorporating STUDY-LEVEL environmental covariates into meta-regression.
    //
    // IMPORTANT: Environmental variables are STUDY-LEVEL characteristics
    // (one value per cohort/GWAS), typically representing population means:
    //   - Mean BMI of the cohort
    //   - Mean age of participants
    //   - % urban residence
    //   - Sex stratification (can run sex-stratified GWAS)
    //   - Prevalence of exposure (e.g., % smokers)
    //
    // This is different from individual-level covariates (use covariate_cols for those).
    // Env-MR-MEGA works with summary statistics - no individual data sharing needed.
    //
    // When mr_mega_env = true, the pipeline tests:
    //   1. Main genetic effect (standard meta-analysis)
    //   2. Ancestry heterogeneity (differences across populations)
    //   3. Environmental heterogeneity (effect modification by study-level env variable)
    //
    // WORKFLOW: Ancestry-stratified GWAS → Population means → env-MR-MEGA
    //   Step 1: Run GWAS separately by ancestry (EUR, AFR, HISP, AAC, etc.)
    //   Step 2: Calculate population means for each ancestry group
    //   Step 3: Use these ancestry-specific means as study-level covariates
    //
    // Example for leukemia (BMI associated with ALL survival & incidence in Latinos):
    //   - mean_bmi: Average BMI per ancestry group (higher in AFR/HISP)
    //   - mean_adi: Average Area Deprivation Index per ancestry group
    //   - mean_survival: 5-year survival rate per ancestry group
    //   - pct_urban: Percentage living in urban areas
    //
    // This tests: "Do genetic effects vary based on population-level BMI/ADI?"
    //             e.g., Does rs12345 have stronger effect in higher-BMI populations?
    //
    // How to specify:
    //   1. Calculate ancestry-stratified population means:
    //      ancestry  mean_bmi  mean_adi  mean_survival
    //      EUR       25.3      0.35      0.72
    //      AFR       28.1      0.52      0.65
    //      HISP      27.5      0.48      0.68
    //      AAC       27.8      0.55      0.64
    //      EAS       23.5      0.32      0.75
    //
    //   2. Set parameters:
    //      mr_mega_env = true
    //      env_variable_file = '/path/to/ancestry_population_means.tsv'
    //      env_variable_cols = 'mean_bmi,mean_adi,mean_survival'
    //
    //   3. Pipeline runs env-MR-MEGA for each ancestry-stratified GWAS,
    //      testing if genetic effects correlate with population BMI/ADI/survival
    //
    // CATEGORICAL VARIABLES (e.g., tumor subtype):
    // For non-continuous variables, use PROPORTIONS as study-level covariates:
    //
    // Example: ALL tumor subtype (B-ALL vs T-ALL)
    //   - pct_ball: Proportion of B-ALL cases per ancestry group
    //   - pct_tall: Proportion of T-ALL cases per ancestry group
    //
    //   ancestry  mean_bmi  pct_ball  pct_tall  pct_hr_cytogenetics
    //   EUR       25.3      0.85      0.15      0.22
    //   AFR       28.1      0.78      0.22      0.28
    //   HISP      27.5      0.82      0.18      0.31
    //   AAC       27.8      0.76      0.24      0.30
    //   EAS       23.5      0.88      0.12      0.19
    //
    // This tests: "Do genetic effects vary by tumor subtype distribution?"
    //             e.g., Does rs12345 have stronger effect in populations with more T-ALL?
    //
    // Alternatively for SUBTYPE-STRATIFIED analysis:
    //   Option A: Run env-MR-MEGA with pct_ball/pct_tall as covariates (tests heterogeneity)
    //   Option B: Run GWAS stratified by BOTH ancestry AND subtype, then meta-analyze
    //             - EUR_BALL, EUR_TALL, AFR_BALL, AFR_TALL, etc.
    //             - Requires sufficient sample size per stratum
    //
    // For ordinal categories (e.g., disease stage I/II/III/IV):
    //   Use mean_stage or proportion above threshold (pct_stage_3_4)
    //
    // =====================
    // USE CASE: CONFOUNDER DETECTION
    // =====================
    // Env-MR-MEGA can also detect CONFOUNDERS that may explain ancestry-specific
    // heterogeneity in genetic effects - not just environmental modifiers.
    //
    // KEY INSIGHT: When study-level covariates (treatment era, consortium source)
    // correlate with ancestry AND explain genetic effect heterogeneity, these are
    // CONFOUNDERS that should be addressed in the primary analysis.
    //
    // Example: Pediatric ALL Multi-Consortium Analysis
    //   Cohort combines samples from multiple treatment eras and consortia:
    //
    //   Consortium Source         Treatment Era    Latino %   Black %   White %
    //   -------------------------------------------------------------------------
    //   REDIAL                    2000-2024        35%        15%       45%
    //   COG P9904/P9905           2000-2007        20%        18%       55%
    //   COG P9906                 2000-2003        22%        17%       54%
    //   COG AALL0232              2004-2011        25%        16%       52%
    //   COG AALL0331              2005-2010        23%        15%       55%
    //   SJCRH Total XV            2000-2008        18%        22%       52%
    //
    // Potential confounders to test:
    //   - pct_from_redial:     Proportion of samples from REDIAL consortium
    //   - pct_from_cog:        Proportion from COG trials
    //   - pct_from_sjcrh:      Proportion from St. Jude
    //   - mean_dx_year:        Mean diagnosis year (treatment era proxy)
    //   - pct_modern_therapy:  Proportion receiving modern risk-adapted therapy
    //
    // Configuration example:
    //   ancestry   mean_dx_year  pct_redial  pct_cog  pct_sjcrh  pct_modern_therapy
    //   EUR        2008.5        0.42        0.48     0.10       0.72
    //   AFR        2007.2        0.35        0.42     0.23       0.65
    //   LATINO     2010.3        0.55        0.38     0.07       0.78
    //   AAC        2006.8        0.32        0.45     0.23       0.62
    //
    // If env-MR-MEGA shows significant heterogeneity explained by pct_redial or
    // mean_dx_year, this suggests genetic effects differ by treatment era or
    // consortium - indicating potential confounding that should be addressed:
    //
    //   1. Stratify primary GWAS by consortium/era, then meta-analyze
    //   2. Include consortium/era as covariates in primary GWAS
    //   3. Report findings as potentially confounded by treatment differences
    //
    // This is DISTINCT from environmental modification (e.g., BMI modifying genetic
    // effects), where the interaction is of biological interest rather than a bias.
    //
    mr_mega_env                = false         // Enable env-MR-MEGA with environmental variables
    env_variable_file          = null          // Study-level covariate file (study_id, env_vars...)
    env_variable_cols          = null          // Comma-separated env variable column names
    // Legacy single variable option (deprecated, use env_variable_cols instead)
    env_variable               = null          // Single environmental variable column name

    // =====================
    // FINE-MAPPING OPTIONS
    // =====================
    fine_mapping               = true
    within_ancestry_fm         = 'polyfun-susie'  // 'polyfun-susie', 'susie', 'finemap', 'caviar'
    multi_ancestry_fm          = 'mg-flash-fm'    // 'mg-flash-fm', 'susie-me', 'paintor'
    single_trait_fm            = 'susie-me'       // Method for single/unrelated traits
    fm_window_kb               = 500              // Fine-mapping window in kb
    fm_max_causal              = 10               // Maximum causal variants
    fm_pip_threshold           = 0.95             // PIP threshold for credible sets
    polyfun_annotations        = null             // Path to PolyFun annotation files

    // =====================
    // COLOCALIZATION OPTIONS
    // =====================
    colocalization             = true
    coloc_method               = 'coloc'       // 'coloc', 'ecaviar', 'fastenloc', 'twas'

    // QTL Dataset Options
    // NOTE: We provide curated diverse QTL sources to address GTEx's limited diversity
    // See assets/qtl_datasets/curated_qtl_sources.yml for available datasets
    use_curated_qtl            = true          // Use curated diverse QTL datasets
    qtl_config                 = null          // Path to custom QTL configuration YAML
    qtl_ancestry_matching      = true          // Match QTL datasets to GWAS ancestry

    // =====================
    // STUDY-TYPE QTL PRESETS
    // =====================
    // Automatically select relevant QTL datasets based on study focus
    // Set study_type to auto-configure QTL databases, or use manual selection below
    study_type                 = null          // Options: 'blood', 'immune', 'psych', 'cardio',
                                               //          'cancer', 'metabolic', 'autoimmune', null (manual)

    // Preset configurations by study type (override with manual options below)
    // 'blood'/'immune' -> OneK1K, DICE, BLUEPRINT, eQTLGen, blood cell sc-eQTLs
    // 'psych'          -> GTEx Brain, PsychENCODE, BrainSeq, CMC, brain caQTL
    // 'cardio'         -> GTEx Heart, CAD/MI QTLs, vascular eQTLs
    // 'cancer'         -> PancanQTL, tumor-specific eQTLs, CancerImmunityQTL
    // 'metabolic'      -> Adipose, liver, pancreas QTLs
    // 'autoimmune'     -> Immune cell QTLs, DICE, OneK1K, synovium QTLs

    // Tissue/cell-type specific QTL selection (when study_type=null or for fine-tuning)
    qtl_tissues                = null          // Comma-separated: 'blood,brain,heart,liver,adipose'
    qtl_cell_types             = null          // Comma-separated: 'T_cell,monocyte,neuron,hepatocyte'
    qtl_disease_focus          = null          // Comma-separated: 'leukemia,schizophrenia,CAD'

    // Standard QTL dataset inputs (user-provided paths)
    eqtl_datasets              = null          // Samplesheet with eQTL summary stats
    sqtl_datasets              = null          // Samplesheet with sQTL summary stats
    pqtl_datasets              = null          // Samplesheet with pQTL summary stats
    mqtl_datasets              = null          // Samplesheet with mQTL summary stats
    caqtl_datasets             = null          // Samplesheet with caQTL summary stats

    // Custom/User-provided QTL datasets
    custom_qtl_datasets        = null          // Custom QTL datasets samplesheet (name,type,path,ancestry,tissue)

    // Curated dataset selection (from curated_qtl_sources.yml)
    // Multi-ethnic prioritized sources:
    qtl_enable_mesa            = true          // MESA (diverse: EUR, AFR, HISP, EAS)
    qtl_enable_page            = true          // PAGE Study (diverse)
    qtl_enable_topmed          = true          // TOPMed eQTL (diverse)

    // African ancestry specific:
    qtl_enable_genoa           = true          // GENOA (African American)
    qtl_enable_jhs             = true          // Jackson Heart Study (African American)
    qtl_enable_cardia          = true          // CARDIA (includes AA)

    // Hispanic/Latino specific:
    qtl_enable_hchs_sol        = true          // HCHS/SOL (Hispanic/Latino)
    qtl_enable_sigma           = true          // SIGMA (Mexican/Latino)

    // East Asian specific:
    qtl_enable_bbj             = true          // BioBank Japan
    qtl_enable_korea           = false         // Korea Biobank
    qtl_enable_taiwan          = false         // Taiwan Biobank

    // European (large sample, use as supplement):
    qtl_enable_gtex            = true          // GTEx v8 (85% European)
    qtl_enable_eqtlgen         = true          // eQTLGen (blood, European)
    qtl_enable_ukb_pqtl        = false         // UK Biobank pQTL

    // Colocalization priors
    coloc_p1                   = 1e-4          // Prior probability for trait association
    coloc_p2                   = 1e-4          // Prior probability for QTL association
    coloc_p12                  = 1e-5          // Prior probability for colocalization

    // =====================
    // PRS OPTIONS
    // =====================
    prs_analysis               = true
    prs_methods                = 'prs-csx,prs-cs,gaudi,ldpred2'  // Methods to run
    prs_validation             = true          // Validate PRS performance
    validation_cohort          = null          // External validation cohort
    prs_ancestry_specific      = true          // Generate ancestry-specific PRS
    prscsx_reference           = null          // PRS-CSx LD reference panels
    prs_best_method            = true          // Determine best method by ancestry

    // =====================
    // HERITABILITY OPTIONS
    // =====================
    heritability               = true
    h2_method                  = 'ldsc'        // 'ldsc', 'gcta', 'bolt-reml', 'greml'
    ancestry_specific_h2       = true          // Estimate h² per ancestry
    gxe_heritability           = true          // Estimate GxE heritability component
    genetic_correlation        = true          // Cross-ancestry genetic correlation

    // =====================
    // FUNCTIONAL ANNOTATION OPTIONS
    // =====================
    functional_annotation      = true
    annotation_tools           = 'magma,fuma,lava,flames'  // Tools to run
    magma_geneset              = null          // MAGMA gene set file
    magma_annotation           = null          // MAGMA annotation file
    fuma_config                = null          // FUMA configuration
    lava_partition             = null          // LAVA partition file
    cell_type_analysis         = true          // Cell-type specific analysis
    cell_type_datasets         = null          // Cell-type expression datasets

    // =====================
    // VISUALIZATION OPTIONS
    // =====================
    visualization              = true
    manhattan_plot             = true
    qq_plot                    = true
    regional_plot              = true
    miami_plot                 = true          // For comparing ancestries
    forest_plot                = true          // Meta-analysis forest plots
    prs_performance_plot       = true

    // =====================
    // REFERENCE FILES
    // =====================
    ld_reference               = null          // Multi-ancestry LD reference panels
    ld_reference_dir           = null          // Directory with ancestry-specific LD panels
    gene_annotation            = null          // Gene annotation file (GTF/GFF)
    dbsnp                      = null          // dbSNP annotation file
    gnomad_af                  = null          // gnomAD allele frequencies

    // =====================
    // RESOURCE OPTIONS
    // =====================
    max_cpus                   = 16
    max_memory                 = '128.GB'
    max_time                   = '240.h'

    // =====================
    // GENERAL OPTIONS
    // =====================
    help                       = false
    version                    = false
    monochrome_logs            = false
    tracedir                   = "${params.outdir}/pipeline_info"
    validate_params            = true
    schema_ignore_params       = 'genomes'

    // =====================
    // CONTAINER OPTIONS
    // =====================
    singularity_pull_docker_container = false
}

// Load base config
includeConfig 'conf/base.config'

// Load modules config
includeConfig 'conf/modules.config'

// Profile configurations
profiles {
    debug {
        dumpHashes             = true
        process.beforeScript   = 'echo $HOSTNAME'
        cleanup                = false
    }
    conda {
        conda.enabled          = true
        docker.enabled         = false
        singularity.enabled    = false
        podman.enabled         = false
        shifter.enabled        = false
        charliecloud.enabled   = false
        apptainer.enabled      = false
    }
    mamba {
        conda.enabled          = true
        conda.useMamba         = true
        docker.enabled         = false
        singularity.enabled    = false
        podman.enabled         = false
        shifter.enabled        = false
        charliecloud.enabled   = false
        apptainer.enabled      = false
    }
    docker {
        docker.enabled         = true
        docker.userEmulation   = true
        conda.enabled          = false
        singularity.enabled    = false
        podman.enabled         = false
        shifter.enabled        = false
        charliecloud.enabled   = false
        apptainer.enabled      = false
    }
    arm {
        docker.runOptions = '-u $(id -u):$(id -g) --platform=linux/amd64'
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        conda.enabled          = false
        docker.enabled         = false
        podman.enabled         = false
        shifter.enabled        = false
        charliecloud.enabled   = false
        apptainer.enabled      = false
    }
    apptainer {
        apptainer.enabled      = true
        apptainer.autoMounts   = true
        conda.enabled          = false
        docker.enabled         = false
        singularity.enabled    = false
        podman.enabled         = false
        shifter.enabled        = false
        charliecloud.enabled   = false
    }
    test {
        includeConfig 'conf/test.config'
    }
    test_full {
        includeConfig 'conf/test_full.config'
    }
    slurm {
        includeConfig 'conf/slurm.config'
    }
    lsf {
        includeConfig 'conf/lsf.config'
    }
    sge {
        includeConfig 'conf/sge.config'
    }
    aws {
        includeConfig 'conf/aws.config'
    }
    gcp {
        includeConfig 'conf/gcp.config'
    }
    azure {
        includeConfig 'conf/azure.config'
    }
}

// Capture exit codes from upstream processes when piping
process.shell = ['/bin/bash', '-euo', 'pipefail']

def trace_timestamp = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')
timeline {
    enabled = true
    file    = "${params.tracedir}/execution_timeline_${trace_timestamp}.html"
}
report {
    enabled = true
    file    = "${params.tracedir}/execution_report_${trace_timestamp}.html"
}
trace {
    enabled = true
    file    = "${params.tracedir}/execution_trace_${trace_timestamp}.txt"
}
dag {
    enabled = true
    file    = "${params.tracedir}/pipeline_dag_${trace_timestamp}.svg"
}

manifest {
    name            = 'ancestry-aware-gwas'
    author          = 'GWAS Pipeline Team'
    homePage        = 'https://github.com/your-org/ancestry-aware-gwas'
    description     = 'Multi-ancestry GWAS pipeline with fine-mapping, meta-analysis, and PRS'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=23.04.0'
    version         = '1.0.0'
}

// Function to ensure that resource requirements don't go beyond max limits
def check_max(obj, type) {
    if (type == 'memory') {
        try {
            if (obj.compareTo(params.max_memory as nextflow.util.MemoryUnit) == 1)
                return params.max_memory as nextflow.util.MemoryUnit
            else
                return obj
        } catch (all) {
            println "   ### ERROR ###   Max memory '${params.max_memory}' is not valid! Using default value: $obj"
            return obj
        }
    } else if (type == 'time') {
        try {
            if (obj.compareTo(params.max_time as nextflow.util.Duration) == 1)
                return params.max_time as nextflow.util.Duration
            else
                return obj
        } catch (all) {
            println "   ### ERROR ###   Max time '${params.max_time}' is not valid! Using default value: $obj"
            return obj
        }
    } else if (type == 'cpus') {
        try {
            return Math.min( obj, params.max_cpus as int )
        } catch (all) {
            println "   ### ERROR ###   Max cpus '${params.max_cpus}' is not valid! Using default value: $obj"
            return obj
        }
    }
}
