/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    SLURM cluster configuration with array job support
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Supports parallelization of:
    - Multiple GWAS types (Tractor LA-aware, standard, ancestry-specific)
    - Multiple PRS methods (PRS-CSx, GAUDI, DiscoDivas, etc.)
    - Multiple QTL types (eQTL, sQTL, pQTL, mQTL, caQTL, hQTL)
    - Multiple traits (OS, relapse, MRD)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {
    executor = 'slurm'
    queue = 'normal'
    clusterOptions = '--account=your_account'

    // Enable array jobs for parallelization
    // Nextflow automatically batches independent tasks into arrays
    array = 100  // Max tasks per array job

    // Adjust based on your cluster
    withLabel:process_single {
        cpus   = 1
        memory = 4.GB
        time   = 1.h
    }
    withLabel:process_low {
        cpus   = 4
        memory = 16.GB
        time   = 4.h
    }
    withLabel:process_medium {
        cpus   = 8
        memory = 32.GB
        time   = 8.h
    }
    withLabel:process_high {
        cpus   = 16
        memory = 64.GB
        time   = 24.h
    }
    withLabel:process_high_memory {
        cpus   = 8
        memory = 200.GB
        time   = 24.h
        queue  = 'bigmem'
    }

    // ================================================================
    // GWAS-specific configurations (multiple GWAS types in parallel)
    // ================================================================
    withName: 'TRACTOR_GWAS' {
        cpus   = 16
        memory = 64.GB
        time   = 24.h
        // Array across chromosomes
        array  = 22
    }

    withName: 'REGENIE_GWAS' {
        cpus   = 16
        memory = 64.GB
        time   = 24.h
        array  = 22
    }

    // ================================================================
    // PRS method parallelization
    // ================================================================
    withName: 'PRS_CSX' {
        cpus   = 16
        memory = 64.GB
        time   = 48.h
        queue  = 'long'
        // Array across ancestries
        array  = 10
    }

    withName: 'PRS_GAUDI|PRS_DISCO_DIVAS|PRS_SDPR_ADMIX' {
        cpus   = 8
        memory = 32.GB
        time   = 24.h
        array  = 22
    }

    withName: 'PRS_MUSSEL|PRS_PROSPER' {
        cpus   = 8
        memory = 32.GB
        time   = 12.h
    }

    // ================================================================
    // Colocalization parallelization
    // ================================================================
    withName: 'COLOC_SUSIE' {
        cpus   = 4
        memory = 16.GB
        time   = 4.h
        // Array across QTL types
        array  = 50
    }

    withName: 'HYPRCOLOC' {
        cpus   = 8
        memory = 32.GB
        time   = 8.h
        array  = 50
    }

    withName: 'OPERA' {
        cpus   = 16
        memory = 64.GB
        time   = 24.h
        // OPERA tests all QTLs simultaneously
        array  = 22  // per chromosome
    }

    // ================================================================
    // LD calculation parallelization
    // ================================================================
    withName: 'CALCULATE_LD' {
        cpus   = 8
        memory = 64.GB
        time   = 12.h
        // Array across ancestry groups
        array  = 10
    }
}

executor {
    queueSize = 500       // Allow more jobs in queue
    submitRateLimit = '20/1min'  // 20 submissions per minute
    pollInterval = '30 sec'
    jobName = { "nf-${task.process}-${task.index}" }
}

// Singularity settings for HPC
singularity {
    enabled = true
    autoMounts = true
    cacheDir = '/scratch/singularity_cache'
    runOptions = '--bind /scratch,/data'
}

// ================================================================
// Parameters for multi-GWAS × multi-method parallelization
// ================================================================
params {
    // GWAS variations to run in parallel
    gwas_types = [
        'tractor_la',           // Tractor local ancestry-aware
        'standard_joint',       // Standard GWAS (all samples)
        'ancestry_specific'     // Per-ancestry GWAS
    ]

    // Traits to analyze (run in parallel)
    traits = [
        'OS',                   // Overall survival
        'relapse',              // Relapse
        'MRD'                   // Minimal residual disease
    ]

    // PRS methods (run in parallel)
    prs_methods = [
        'prs_csx',              // Primary
        'gaudi',                // Local ancestry-aware
        'disco_divas',          // Ancestry-specific decomposition
        'sdpr_admix',           // Admixture-aware
        'mussel',               // Stacking ensemble
        'prosper'               // Penalized regression
    ]

    // QTL types (run in parallel for colocalization)
    qtl_types = [
        'eqtl', 'sqtl', 'pqtl', 'mqtl', 'caqtl', 'hqtl'
    ]

    // Ancestries for stratified analysis
    ancestries = ['EUR', 'AFR', 'AMR', 'EAS']
}

// ================================================================
// Resource scaling based on array size
// ================================================================
process {
    // Dynamic resource allocation based on input size
    withLabel:process_scaling {
        cpus   = { check_max( 4 * task.attempt, 'cpus' ) }
        memory = { check_max( 8.GB * task.attempt, 'memory' ) }
        time   = { check_max( 4.h * task.attempt, 'time' ) }
        errorStrategy = 'retry'
        maxRetries = 3
    }
}
